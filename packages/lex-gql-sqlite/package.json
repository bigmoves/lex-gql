{
  "name": "lex-gql-sqlite",
  "version": "0.2.1",
  "description": "SQLite adapter for lex-gql",
  "type": "module",
  "main": "src/lex-gql-sqlite.js",
  "types": "src/lex-gql-sqlite.d.ts",
  "exports": {
    ".": {
      "types": "./src/lex-gql-sqlite.d.ts",
      "default": "./src/lex-gql-sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "graphql",
    "atproto",
    "lexicon",
    "sqlite",
    "adapter"
  ],
  "license": "MIT",
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0",
    "lex-gql": ">=0.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^12.6.0",
    "lex-gql": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  }
}
