{
  "name": "lex-gql-duckdb",
  "version": "0.2.0",
  "description": "DuckDB adapter for lex-gql - optimized for analytics queries",
  "type": "module",
  "main": "src/lex-gql-duckdb.js",
  "types": "src/lex-gql-duckdb.d.ts",
  "exports": {
    ".": {
      "types": "./src/lex-gql-duckdb.d.ts",
      "default": "./src/lex-gql-duckdb.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "graphql",
    "atproto",
    "lexicon",
    "duckdb",
    "analytics",
    "adapter"
  ],
  "license": "MIT",
  "peerDependencies": {
    "duckdb": ">=1.0.0",
    "lex-gql": ">=0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "duckdb": "^1.4.3",
    "lex-gql": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  }
}
